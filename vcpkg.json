{
  "name": "sushi",
  "version-string": "1.0.0",
  "homepage": "https://github.com/elk-audio/sushi",
  "description": "Headless plugin host for Elk Audio OS",
  "dependencies": [
    {
      "name": "grpc",
      "features": [
        "codegen"
      ]
    },
    {
      "name": "libsndfile",
      "default-features": false
    },
    "rtmidi",
    "lv2",
    "lilv",
    "zeromq",
    {
      "name": "pkgconf",
      "platform": "windows"
    }
  ],
  "features": {
    "sentry": {
      "description": "Sentry.io crash reporting support (use with -DSUSHI_WITH_SENTRY=ON)",
      "dependencies": [
        "sentry-native"
      ]
    }
  }
}
